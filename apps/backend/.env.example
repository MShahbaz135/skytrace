# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# OpenSky Network
#
# Since March 2026 the REST API only accepts OAuth2 client-credentials tokens.
# Create an API client at https://opensky-network.org/my-opensky/account and
# paste the pair below. Leaving them blank falls back to anonymous access,
# which drops the daily allowance from 4,000 credits to 400.
# ---------------------------------------------------------------------------
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_AUTH_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_TOKEN_REFRESH_MARGIN_SEC=300
OPENSKY_REQUEST_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Polling
#
# Upstream state vectors only change every 5-10s, so polling faster than the
# base interval spends credits without gaining freshness. The effective
# interval stretches automatically as the credit balance falls.
# ---------------------------------------------------------------------------
POLL_BASE_INTERVAL_MS=10000
POLL_MIN_INTERVAL_MS=5000
POLL_MAX_INTERVAL_MS=120000
POLL_MAX_REQUESTS_PER_CYCLE=3
AIRCRAFT_STALE_MS=120000

# ---------------------------------------------------------------------------
# adsbdb (aircraft and route enrichment)
#
# Free and keyless. Rate limited at roughly 512 requests per window, so the
# queue below stays well under that and caches everything it resolves.
# ---------------------------------------------------------------------------
ADSBDB_BASE_URL=https://api.adsbdb.com/v0
ADSBDB_REQUESTS_PER_SECOND=4
ADSBDB_REQUEST_TIMEOUT_MS=10000
ADSBDB_ROUTE_TTL_MS=2592000000
ADSBDB_NEGATIVE_TTL_MS=604800000
ADSBDB_MAX_QUEUE_SIZE=5000

# ---------------------------------------------------------------------------
# PostgreSQL (optional)
#
# Backs the enrichment cache. Leave DB_HOST blank to run without a database;
# enrichment then caches in memory for the lifetime of the process.
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=skytrace

# ---------------------------------------------------------------------------
# Replay fallback
#
# auto   — loop the recorded fixture when OpenSky fails or runs out of credits
# always — serve the fixture even when OpenSky is healthy (used for docs/e2e)
# off    — never fall back; the map stays empty if the upstream feed is down
# ---------------------------------------------------------------------------
REPLAY_MODE=auto
REPLAY_FIXTURE_PATH=fixtures/states-replay.json
REPLAY_LOOP_SECONDS=1800
